{
  "schema_version": 1,
  "product": "Byte",
  "repository": "thiepn/byte",
  "release_channels": {
    "stable": {
      "tag_pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "github_surface": "https://github.com/thiepn/byte/releases/latest",
      "automatic_download": false,
      "automatic_install": false
    },
    "beta": {
      "tag_pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-beta\\.[0-9]+$",
      "github_surface": "https://github.com/thiepn/byte/releases",
      "automatic_download": false,
      "automatic_install": false
    }
  },
  "compatibility": {
    "target": "x86_64-pc-windows-msvc",
    "primary_user_os": "Windows 11 versions supported by Microsoft",
    "ci_runners": [
      "windows-2022",
      "windows-2025"
    ],
    "webview2_required": true
  },
  "configuration": {
    "current_schema": 9,
    "minimum_migratable_schema": 1,
    "downgrade_supported": false,
    "user_data_preserved_on_uninstall": true
  },
  "maintenance": {
    "security_audit_cadence": "weekly",
    "dependency_updates": "dependabot-weekly",
    "hotfix_strategy": "patch-forward",
    "forced_auto_update": false
  },
  "distribution": {
    "public_release_requires_authenticode": true,
    "installer_requires_authenticode": true,
    "portable_binary_requires_authenticode": true,
    "timestamp_required": true,
    "same_signer_required": true,
    "unsigned_release_candidates_allowed": true,
    "publisher": "THIEPN",
    "homepage": "https://thiepn.dev/byte/"
  },
  "product_certification": {
    "automated_runtime_gate": true,
    "fresh_first_run": true,
    "onboarding_boundary": true,
    "display_modes": [
      "HABITAT",
      "PERCH",
      "MINI",
      "EDGE",
      "TRAY"
    ],
    "interface_scales": [
      100,
      110,
      125,
      150,
      175,
      200
    ],
    "runtime_schema_migration": true,
    "corrupt_config_recovery": true,
    "sustained_runtime_seconds": 30,
    "manual_device_signoff_required": true,
    "manual_device_areas": [
      "first-run-onboarding-ux",
      "fullscreen-presentation-restore",
      "lock-display-sleep-wake",
      "multi-monitor-mixed-dpi",
      "notification-permission-quality",
      "representative-device-performance",
      "visual-accessibility-qa",
      "installer-update-trust-ux"
    ],
    "physical_device_signoff": {
      "tooling_required": true,
      "runner_script": "scripts/run-physical-device-signoff.ps1",
      "verifier_script": "scripts/verify-physical-device-signoff.ps1",
      "minimum_performance_minutes_per_state": 10,
      "performance_states": [
        "ACTIVE_CALM",
        "FULLSCREEN_REDUCED",
        "LOCKED_DISPLAY_OFF"
      ],
      "thresholds": {
        "cpu_average_percent_max": 0.25,
        "working_set_average_mb_max": 60,
        "gpu_average_percent_max": 1,
        "disk_write_average_bytes_per_sec_max": 4096,
        "remote_tcp_connections_max": 0
      },
      "public_release_requires_signed_candidate": true,
      "public_release_requires_dual_display_coverage": true,
      "public_release_allows_capability_gaps": false,
      "signed_candidate_workflow": ".github/workflows/device-signoff-candidate.yml",
      "signed_candidate_retention_days": 14,
      "signed_candidate_main_only": true,
      "candidate_bound_verifier_harness": "scripts/test-physical-device-signoff-verifier.ps1"
    },
    "release_approval": {
      "tooling_required": true,
      "orchestrator_script": "scripts/run-release-approval.ps1",
      "verifier_script": "scripts/verify-release-approval.ps1",
      "verifier_harness": "scripts/test-release-approval-verifier.ps1",
      "receipt_schema_version": 1,
      "source_branch": "main",
      "exact_remote_main_required": true,
      "clean_working_tree_required": true,
      "signed_candidate_required_for_tagging": true,
      "public_device_report_required_for_tagging": true,
      "automatic_tagging": false,
      "automatic_release_publish": false
    }
  }
}
