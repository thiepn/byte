{
  "name": "byte-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify": "npm run check && npm run test && npm run build",
    "visual:audit": "node scripts/audit-visual-assets.mjs",
    "design:verify": "node scripts/verify-byte2-identity.mjs",
    "design:test": "vitest run scripts/verify-byte2-identity.test.mjs",
    "release:verify": "node scripts/verify-release-version.mjs",
    "bundle:windows": "tauri build --bundles nsis",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "maintenance:verify": "node scripts/verify-maintenance-policy.mjs",
    "device:signoff": "pwsh -NoProfile -File scripts/run-physical-device-signoff.ps1",
    "device:signoff:verify": "pwsh -NoProfile -File scripts/verify-physical-device-signoff.ps1",
    "device:signoff:tooling": "pwsh -NoProfile -File scripts/test-physical-device-signoff-tooling.ps1",
    "release:approve": "pwsh -NoProfile -File scripts/run-release-approval.ps1",
    "release:approve:verify": "pwsh -NoProfile -File scripts/verify-release-approval.ps1",
    "release:approve:tooling": "pwsh -NoProfile -File scripts/test-release-approval-tooling.ps1",
    "release:initiate": "pwsh -NoProfile -File scripts/run-release-initiation.ps1",
    "release:initiate:verify": "pwsh -NoProfile -File scripts/verify-release-initiation.ps1",
    "release:initiate:tooling": "pwsh -NoProfile -File scripts/test-release-initiation-tooling.ps1",
    "release:complete": "pwsh -NoProfile -File scripts/run-release-completion.ps1",
    "release:complete:verify": "pwsh -NoProfile -File scripts/verify-release-completion.ps1",
    "release:complete:tooling": "pwsh -NoProfile -File scripts/test-release-completion-tooling.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "2.11.5",
    "prettier": "^3.9.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "@types/node": "^24.0.0",
    "@typescript-eslint/types": "^8.70.0"
  }
}
