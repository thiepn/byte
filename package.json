{
  "name": "byte-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "2.11.5",
    "prettier": "^3.9.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/types": "^8.70.0"
  }
}
